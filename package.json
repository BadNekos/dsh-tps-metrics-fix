{
  "name": "@local/dsh-tps-metrics-fix",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "description": "Consistent end-to-end request and session token rates for DSH, with guarded existing-UI adapters.",
  "license": "MIT",
  "engines": { "dsh": ">=0.2.1-rc.5" },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg",
    "./package.json": "./package.json"
  },
  "files": ["index.js", "metrics.js", "client.js", "cordis.patch.yml", "locale/*.json", "icon.svg", "README.md", "LICENSE"],
  "scripts": { "test": "node --test tests/*.test.mjs" },
  "dependencies": {
    "@deepseek-ai/schemastery": "3.18.5",
    "zod": "4.4.3"
  },
  "peerDependencies": { "@deepseek-ai/cordis": "~4.0.5" },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "inject": ["@deepseek-ai/dsh-client-ui-chat", "@deepseek-ai/dsh-client-ui-trajectory"]
    }
  }
}
